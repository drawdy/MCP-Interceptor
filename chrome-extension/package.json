{
  "name": "chrome-extension",
  "version": "0.4.0",
  "description": "MCP-Interceptor browser extension for connecting MCP tools to AI chat websites",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "clean:node_modules": "pnpm dlx rimraf node_modules",
    "clean:turbo": "rimraf .turbo",
    "clean": "pnpm clean:turbo && pnpm clean:node_modules",
    "ready": "tsc -b pre-build.tsconfig.json",
    "build": "vite build",
    "dev": "vite build --mode development",
    "test": "node --disallow-code-generation-from-strings --test tests/*.test.mjs",
    "lint": "eslint .",
    "lint:fix": "pnpm lint --fix",
    "prettier": "prettier . --write --ignore-path ../.prettierignore",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@extension/env": "workspace:*",
    "@extension/shared": "workspace:*",
    "@extension/storage": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "webextension-polyfill": "^0.12.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@extension/dev-utils": "workspace:*",
    "@extension/hmr": "workspace:*",
    "@extension/tsconfig": "workspace:*",
    "@extension/vite-config": "workspace:*",
    "@laynezh/vite-plugin-lib-assets": "^2.1.3",
    "@types/chrome": "0.3.7",
    "@types/node": "^22.5.5",
    "magic-string": "^1.4.5",
    "ts-loader": "^9.6.2"
  },
  "author": "drawdy (https://github.com/drawdy)",
  "bugs": {
    "url": "https://github.com/drawdy/MCP-Interceptor/issues"
  }
}
